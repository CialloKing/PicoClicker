#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "clicker.manifest"

IDD_MAIN DIALOG 0, 0, 166, 82
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "PicoClicker"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "点击间隔 (ms)", -1, 7, 9, 63, 11
    EDITTEXT IDC_INTERVAL, 75, 7, 84, 14, ES_NUMBER | ES_AUTOHSCROLL
    AUTORADIOBUTTON "左键", IDC_LEFT, 7, 28, 43, 11, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "中键", IDC_MIDDLE, 57, 28, 43, 11
    AUTORADIOBUTTON "右键", IDC_RIGHT, 107, 28, 52, 11
    DEFPUSHBUTTON "开始 (F6)", IDC_TOGGLE, 7, 44, 152, 15, WS_GROUP
    LTEXT "就绪", IDC_STATUS, 7, 64, 152, 11
END
