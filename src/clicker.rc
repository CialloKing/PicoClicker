#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

#ifndef PICOCLICKER_DIALOG_ONLY
1 RT_MANIFEST "clicker.manifest"
#endif

#ifndef PICOCLICKER_EMBED_DIALOG
#ifdef PICOCLICKER_LITE
#define HOTKEY_ROW_HEIGHT 0
#else
#define HOTKEY_ROW_HEIGHT 20
#endif

IDD_MAIN DIALOG 0, 0, 174, 83 + HOTKEY_ROW_HEIGHT
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "PicoClicker"
FONT 9, "Segoe UI"
BEGIN
    LTEXT PICO_TEXT("间隔 (ms)", "ms"), -1, 7, 9, 59, 11
    // Initialize the interval in the resource without a startup API call.
    CONTROL "100", IDC_INTERVAL, "Edit", ES_NUMBER | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP, 70, 7, 97, 14
#ifndef PICOCLICKER_LITE
    LTEXT "快捷键", -1, 7, 29, 59, 11
    PUSHBUTTON "F1", IDC_HOTKEY, 70, 26, 97, 15
#endif
    AUTORADIOBUTTON PICO_TEXT("左键", "Left"), IDC_LEFT, 7, 29 + HOTKEY_ROW_HEIGHT, 43, 11, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON PICO_TEXT("中键", "Mid"), IDC_MIDDLE, 60, 29 + HOTKEY_ROW_HEIGHT, 43, 11
    AUTORADIOBUTTON PICO_TEXT("右键", "Right"), IDC_RIGHT, 114, 29 + HOTKEY_ROW_HEIGHT, 53, 11
    DEFPUSHBUTTON PICO_TEXT("开始", "Start"), IDC_TOGGLE, 7, 45 + HOTKEY_ROW_HEIGHT, 160, 15, WS_GROUP
    // WM_INITDIALOG fills this control with the actual hotkey status.
    LTEXT "", IDC_STATUS, 7, 65 + HOTKEY_ROW_HEIGHT, 160, 11
END
#endif
