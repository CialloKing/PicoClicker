#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "clicker.manifest"

#ifdef PICOCLICKER_LITE
#define HOTKEY_ROW_HEIGHT 0
#else
#define HOTKEY_ROW_HEIGHT 20
#endif

IDD_MAIN DIALOG 0, 0, 174, 83 + HOTKEY_ROW_HEIGHT
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "PicoClicker"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "点击间隔 (ms)", -1, 7, 9, 59, 11
#ifdef PICOCLICKER_LITE
    // Initialize the interval in the resource without a startup API call.
    CONTROL "100", IDC_INTERVAL, "Edit", ES_NUMBER | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP, 70, 7, 97, 14
#else
    EDITTEXT IDC_INTERVAL, 70, 7, 97, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "快捷键", -1, 7, 29, 59, 11
    PUSHBUTTON "F1", IDC_HOTKEY, 70, 26, 97, 15
#endif
    AUTORADIOBUTTON "左键", IDC_LEFT, 7, 29 + HOTKEY_ROW_HEIGHT, 43, 11, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "中键", IDC_MIDDLE, 60, 29 + HOTKEY_ROW_HEIGHT, 43, 11
    AUTORADIOBUTTON "右键", IDC_RIGHT, 114, 29 + HOTKEY_ROW_HEIGHT, 53, 11
    DEFPUSHBUTTON "开始", IDC_TOGGLE, 7, 45 + HOTKEY_ROW_HEIGHT, 160, 15, WS_GROUP
    LTEXT "就绪", IDC_STATUS, 7, 65 + HOTKEY_ROW_HEIGHT, 160, 11
END
