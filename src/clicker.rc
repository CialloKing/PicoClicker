#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "clicker.manifest"

IDD_MAIN DIALOG 0, 0, 174, 103
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "PicoClicker"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "点击间隔 (ms)", -1, 7, 9, 59, 11
    EDITTEXT IDC_INTERVAL, 70, 7, 97, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "快捷键", -1, 7, 29, 59, 11
    PUSHBUTTON "F1", IDC_HOTKEY, 70, 26, 97, 15
    AUTORADIOBUTTON "左键", IDC_LEFT, 7, 49, 43, 11, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "中键", IDC_MIDDLE, 60, 49, 43, 11
    AUTORADIOBUTTON "右键", IDC_RIGHT, 114, 49, 53, 11
    DEFPUSHBUTTON "开始", IDC_TOGGLE, 7, 65, 160, 15, WS_GROUP
    LTEXT "就绪", IDC_STATUS, 7, 85, 160, 11
END
